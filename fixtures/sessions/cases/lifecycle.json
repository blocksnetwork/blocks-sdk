    {
      "id": "provider.probe.echoed",
      "summary": "a backend route_probe is recognized by type and its nonce echoed",
      "receiver": "provider",
      "given": {
        "state": "ready"
      },
      "steps": [
        {
          "from": "backend",
          "message": {
            "type": "route_probe",
            "protocolVersion": "2026-05-01",
            "nonce": "n-1"
          },
          "expect": "dispatch"
        }
      ],
      "expect": {
        "state": "ready",
        "probeEchoes": [
          "n-1"
        ]
