# Blocks CLI — local development environment
# Copy to .env and fill in values from AWS Secrets Manager.
#
#   cp .env.example .env
#
# Then either:
#   set -a && source .env && set +a && go run . login
#   make build && ./blocks login

# Blocks backend URL and OAuth client ID
BLOCKS_BACKEND_URL=http://localhost:3001
BLOCKS_CLI_CLIENT_ID=<secret>

# Comma-separated list of SDK debug subsystems to enable. Not implied by
# LOG_LEVEL=debug. Values: diagnostics, forward_transport
# BLOCKS_DEBUG_INTERNAL=diagnostics,forward_transport
