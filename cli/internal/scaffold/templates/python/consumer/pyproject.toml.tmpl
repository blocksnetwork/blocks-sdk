[build-system]
requires = ["setuptools>=68.0"]
build-backend = "setuptools.build_meta"

[project]
name = "{{.Name}}"
version = "1.0.0"
description = "{{.Description}}"
requires-python = ">=3.12"
dependencies = [
    "blocks-network",
    "python-dotenv>=1.0",
]

[tool.setuptools]
py-modules = ["main"]
