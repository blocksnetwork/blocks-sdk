import 'dotenv/config';
import { BillingModeMismatchError, RpcError, TaskClient, textPart } from '@blocks-network/sdk';
import type { ProgressEvent, ArtifactEvent, TerminalEvent } from '@blocks-network/sdk';

/**
 * {{.Name}} — a script that calls an agent.
 * Sends a task to AGENT_NAME and prints progress, artifacts, and the
 * terminal result.
 *
 * Usage: npm run start
 */

{{if .TargetAgent -}}
// The agent this script calls, chosen when the project was created.
const AGENT_NAME: string = '{{.TargetAgent}}';
{{- else -}}
// The bare name of the agent this script calls (e.g. 'translator'). To find
// one, search with 'blocks init' (Call an agent), or browse with
// 'blocks dashboard'.
const AGENT_NAME: string = '';
{{- end}}

if (!AGENT_NAME) {
  console.error(
    "AGENT_NAME is not set. Edit index.ts and set it to an agent you can call: search with 'blocks init' (Call an agent), or browse with 'blocks dashboard'.",
  );
  process.exit(1);
}

const apiKey = process.env.BLOCKS_API_KEY;
if (!apiKey) {
  console.error(
    "BLOCKS_API_KEY not set. This script runs without the Blocks CLI, so it cannot use your 'blocks login' profile: run 'blocks login --write-env' to copy its key into .env, or set BLOCKS_API_KEY in .env yourself.",
  );
  process.exit(1);
}

function isAgentNotFound(err: unknown): boolean {
  if (!(err instanceof RpcError)) return false;
  const data = err.data as { code?: unknown } | null | undefined;
  return data?.code === 'NotFound' || err.rpcMessage.toLowerCase().includes('not found');
}

function describeTerminal(terminal: TerminalEvent): string {
  const detail = terminal.error ?? terminal.reason;
  return detail ? `${terminal.state}: ${detail}` : terminal.state;
}

async function main() {
  // billingMode must match the agent's registered billing mode, or the task is
  // rejected with BillingModeMismatch.
  const client = await TaskClient.create({
    billingMode: '{{.CallerBillingMode}}',
    apiKey,
  });

  let session;
  try {
    session = await client.sendMessage({
      agentName: AGENT_NAME,
      requestParts: [textPart('Hello from {{.Name}}!', 'request')],
    });
  } catch (err) {
    client.destroy();
    if (err instanceof BillingModeMismatchError) {
      console.error(
        `Agent '${AGENT_NAME}' uses billing mode '${err.expected}'; set billingMode: '${err.expected}' in index.ts.`,
      );
      process.exit(1);
    }
    if (!isAgentNotFound(err)) throw err;
    console.error(
      `Agent '${AGENT_NAME}' was not found, or this API key cannot call it. Check AGENT_NAME in index.ts.`,
    );
    process.exit(1);
  }

  console.log('Task created:', session.taskId);

  session.onProgress((event: ProgressEvent) => {
    console.log('[progress]', event.message ?? event.progress ?? '');
  });
  session.onArtifact((event: ArtifactEvent) => {
    // Log arrival only; download happens after terminal so the list is authoritative.
    console.log('[artifact-ref]', event.artifactRef.fileName ?? event.artifactRef.mimeType);
  });

  // waitForTerminal (not onTerminal) resolves immediately for tasks that
  // are already terminal by the time we subscribe, so fast / idempotent
  // hits don't hang.
  const terminal = await session.waitForTerminal(60_000);
  try {
    console.log('[done]', describeTerminal(terminal));
    for (const ref of session.listArtifacts()) {
      try {
        const downloaded = await session.downloadArtifact(ref);
        console.log('[artifact]', new TextDecoder().decode(downloaded.data));
      } catch (err) {
        console.error('[artifact] download failed:', err);
      }
    }
  } finally {
    session.close();
    client.destroy();
  }

  process.exit(terminal.state === 'completed' ? 0 : 1);
}

main().catch((err) => {
  console.error(err);
  process.exit(1);
});
