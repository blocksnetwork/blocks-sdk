{
  "identity": {
    "agentName": "request_nostream_node",
    "displayName": "request_nostream_node",
    "description": "request_nostream_node agent",
    "version": "1.0.0",
    "provider": {
      "organization": "PubNub"
    }
  },
  "capabilities": {
    "taskKinds": ["request"]
  },
  "io": {
    "inputs": [
      {
        "id": "request",
        "description": "Text payload to echo back",
        "contentType": "application/json",
        "required": true,
        "example": {
          "text": "Hello from request_nostream_node!"
        },
        "schema": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": {
              "type": "string",
              "title": "Text to Echo",
              "default": "Hello from request_nostream_node!"
            }
          }
        }
      }
    ],
    "outputs": [
      {
        "id": "result",
        "description": "Task result",
        "contentType": "application/json",
        "guaranteed": true
      }
    ]
  },
  "skills": [
    {
      "id": "main",
      "name": "Main Skill",
      "description": "Handles tasks"
    }
  ],
  "runtime": {
    "handler": "./handler.ts",
    "handlerExport": "default",
    "concurrency": 1,
    "expectedInstances": 1
  }
}
