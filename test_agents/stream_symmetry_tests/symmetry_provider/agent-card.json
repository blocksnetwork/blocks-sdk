{
  "identity": {
    "agentName": "symmetry_provider",
    "displayName": "Symmetry Test Provider",
    "description": "BLOCKS-262 round-trip symmetry test. Sends and receives bytes + events streams in both directions, hashes both sides, returns digests as a final artifact.",
    "version": "1.0.0",
    "provider": {
      "organization": "symmetry_provider"
    }
  },
  "capabilities": {
    "taskKinds": [
      "pipe"
    ]
  },
  "io": {
    "inputs": [
      {
        "id": "request",
        "description": "Optional test driver options (currently unused).",
        "contentType": "application/json",
        "required": false,
        "example": {},
        "schema": {
          "type": "object",
          "properties": {}
        }
      }
    ],
    "outputs": [
      {
        "id": "report",
        "description": "Hash digests for all four streams: provider_sent_bytes, provider_sent_events, provider_received_bytes, provider_received_events.",
        "contentType": "application/json",
        "guaranteed": true
      }
    ]
  },
  "streams": {
    "p_to_c_bytes": {
      "direction": "outbound",
      "format": "bytes",
      "affinity": "dedicated",
      "description": "Provider->consumer bytes stream."
    },
    "p_to_c_events": {
      "direction": "outbound",
      "format": "events",
      "affinity": "dedicated",
      "description": "Provider->consumer events stream."
    },
    "c_to_p_bytes": {
      "direction": "inbound",
      "format": "bytes",
      "affinity": "dedicated",
      "description": "Consumer->provider bytes stream."
    },
    "c_to_p_events": {
      "direction": "inbound",
      "format": "events",
      "affinity": "dedicated",
      "description": "Consumer->provider events stream."
    }
  },
  "skills": [
    {
      "id": "symmetry_test",
      "name": "Round-trip symmetry test",
      "description": "Round-trips bytes and events streams in both directions and returns hash digests for cross-side verification."
    }
  ],
  "runtime": {
    "handler": "./handler.ts",
    "handlerExport": "default",
    "concurrency": 1,
    "expectedInstances": 1
  }
}
