{
  "identity": {
    "agentName": "symmetry_provider_py",
    "displayName": "Symmetry Test Provider (Python)",
    "description": "BLOCKS-262 round-trip symmetry test (Python). Sends and receives bytes + events streams in both directions, hashes both sides, returns digests as a final artifact. Mirror of symmetry_provider (Node).",
    "version": "1.0.0",
    "provider": {
      "organization": "symmetry_provider_py"
    }
  },
  "capabilities": {
    "taskKinds": [
      "pipe"
    ]
  },
  "io": {
    "inputs": [
      {
        "id": "request",
        "description": "Optional test driver options (currently unused).",
        "contentType": "application/json",
        "required": false,
        "example": {},
        "schema": {
          "type": "object",
          "properties": {}
        }
      }
    ],
    "outputs": [
      {
        "id": "report",
        "description": "Hash digests for all four streams.",
        "contentType": "application/json",
        "guaranteed": true
      }
    ]
  },
  "streams": {
    "p_to_c_bytes": {
      "direction": "outbound",
      "format": "bytes",
      "affinity": "dedicated",
      "description": "Provider->consumer bytes stream."
    },
    "p_to_c_events": {
      "direction": "outbound",
      "format": "events",
      "affinity": "dedicated",
      "description": "Provider->consumer events stream."
    },
    "c_to_p_bytes": {
      "direction": "inbound",
      "format": "bytes",
      "affinity": "dedicated",
      "description": "Consumer->provider bytes stream."
    },
    "c_to_p_events": {
      "direction": "inbound",
      "format": "events",
      "affinity": "dedicated",
      "description": "Consumer->provider events stream."
    }
  },
  "skills": [
    {
      "id": "symmetry_test",
      "name": "Round-trip symmetry test",
      "description": "Round-trips bytes and events streams in both directions and returns hash digests for cross-side verification."
    }
  ],
  "runtime": {
    "handler": "./handler.py",
    "handlerExport": "handler",
    "concurrency": 1,
    "expectedInstances": 1
  }
}
