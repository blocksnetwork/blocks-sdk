{
  "identity": {
    "agentName": "request_stream_node",
    "displayName": "request_stream_node",
    "description": "request_stream_node agent",
    "version": "1.0.0",
    "provider": {
      "organization": "PubNub"
    }
  },
  "capabilities": {
    "taskKinds": ["request"]
  },
  "io": {
    "inputs": [
      {
        "id": "request",
        "description": "Message and stream duration in seconds",
        "contentType": "application/json",
        "required": true,
        "example": {
          "message": "Hello from request_stream_node!",
          "seconds": 3
        },
        "schema": {
          "type": "object",
          "required": ["message", "seconds"],
          "properties": {
            "message": {
              "type": "string",
              "title": "Message",
              "default": "Hello from request_stream_node!"
            },
            "seconds": {
              "type": "integer",
              "title": "Stream Duration (seconds)",
              "default": 3
            }
          }
        }
      }
    ],
    "outputs": [
      {
        "id": "result",
        "description": "Task result",
        "contentType": "application/json",
        "guaranteed": true
      }
    ]
  },
  "streams": {
    "_default": {
      "direction": "outbound",
      "format": "events",
      "description": "Default event stream for task progress."
    }
  },
  "skills": [
    {
      "id": "main",
      "name": "Main Skill",
      "description": "Handles tasks"
    }
  ],
  "runtime": {
    "handler": "./handler.ts",
    "handlerExport": "default",
    "concurrency": 1,
    "expectedInstances": 1
  }
}
