{
  "identity": {
    "agentName": "data_transformer",
    "displayName": "data-transformer",
    "description": "Transforms data between CSV and JSON with filtering, mapping, and aggregation",
    "version": "1.0.0",
    "provider": {
      "organization": "PubNub"
    }
  },
  "capabilities": {
    "taskKinds": ["request"]
  },
  "io": {
    "inputs": [
      {
        "id": "transform_params",
        "contentType": "application/json",
        "required": true,
        "description": "Transformation parameters and source data",
        "example": {
          "kind": "transform",
          "inputFormat": "csv",
          "outputFormat": "json",
          "data": "name,age\nAlice,30\nBob,25"
        },
        "schema": {
          "type": "object",
          "required": ["kind", "inputFormat", "outputFormat", "data"],
          "properties": {
            "kind": { "type": "string", "const": "transform" },
            "inputFormat": {
              "type": "string",
              "title": "Input Format",
              "enum": ["csv", "json"],
              "default": "csv"
            },
            "outputFormat": {
              "type": "string",
              "title": "Output Format",
              "enum": ["csv", "json"],
              "default": "json"
            },
            "data": {
              "type": "string",
              "title": "Data",
              "description": "The data to transform"
            }
          }
        }
      }
    ],
    "outputs": [
      {
        "id": "json_result",
        "contentType": "application/json",
        "guaranteed": false,
        "description": "Transformed JSON data with stats"
      },
      {
        "id": "csv_result",
        "contentType": "text/csv",
        "guaranteed": false,
        "description": "Transformed CSV data"
      }
    ]
  },
  "skills": [
    {
      "id": "transform",
      "name": "Data Transform",
      "description": "Converts structured data between CSV and JSON formats"
    }
  ],
  "runtime": {
    "handler": "./handler.ts",
    "handlerExport": "default",
    "concurrency": 1
  }
}
