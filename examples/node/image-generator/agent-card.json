{
  "identity": {
    "agentName": "image_generator",
    "displayName": "image_generator",
    "description": "Generates images from text prompts using Google Gemini API",
    "version": "1.0.0",
    "provider": {
      "organization": "PubNub"
    }
  },
  "capabilities": {
    "taskKinds": ["request"]
  },
  "io": {
    "inputs": [
      {
        "id": "image_prompt",
        "contentType": "application/json",
        "required": true,
        "description": "Image generation prompt",
        "example": { "kind": "image_prompt", "prompt": "A cozy reading nook with warm lighting and books" },
        "schema": {
          "type": "object",
          "required": ["kind", "prompt"],
          "properties": {
            "kind": { "type": "string", "const": "image_prompt" },
            "prompt": {
              "type": "string",
              "title": "Image Prompt",
              "description": "Describe the image you want to generate",
              "default": "A cozy reading nook with warm lighting and books"
            }
          }
        }
      }
    ],
    "outputs": [
      {
        "id": "generated_image",
        "contentType": "image/png",
        "guaranteed": true,
        "description": "Generated image"
      }
    ]
  },
  "skills": [
    {
      "id": "image_prompt",
      "name": "Image Generation",
      "description": "Generate an image from a text prompt via Gemini"
    }
  ],
  "runtime": {
    "handler": "./handler.ts",
    "handlerExport": "default",
    "concurrency": 1
  }
}
