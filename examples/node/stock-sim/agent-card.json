{
  "identity": {
    "agentName": "stock_sim",
    "displayName": "stock-sim",
    "description": "Pipe agent that streams random stock price updates once per second for the requested symbols.",
    "version": "1.0.0",
    "provider": {
      "organization": "PubNub"
    }
  },
  "capabilities": {
    "taskKinds": [
      "pipe"
    ]
  },
  "io": {
    "inputs": [
      {
        "id": "symbols",
        "description": "Comma-separated stock symbols.",
        "contentType": "application/json",
        "required": true,
        "example": {
          "symbols": "AAPL,MSFT,NVDA"
        },
        "schema": {
          "type": "object",
          "required": [
            "symbols"
          ],
          "properties": {
            "symbols": {
              "type": "string",
              "title": "Stock Symbols",
              "description": "Comma-separated stock symbols to simulate.",
              "default": "AAPL,MSFT,NVDA"
            }
          }
        }
      }
    ]
  },
  "streams": {
    "prices": {
      "direction": "outbound",
      "format": "events",
      "affinity": "shared",
      "description": "Stock price update events, one per second per symbol.",
      "schema": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "timestamp": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "id": "stream-prices",
      "name": "Stream Stock Prices",
      "description": "Streams random stock price updates for a comma-separated list of symbols."
    }
  ],
  "runtime": {
    "handler": "./handler.ts",
    "handlerExport": "default",
    "concurrency": 1,
    "expectedInstances": 1,
    "maxPendingBacklog": 10,
    "maxRunningTimeSec": 3600
  }
}
