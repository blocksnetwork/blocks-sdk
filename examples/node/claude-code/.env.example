# CDM config URL (provides PubNub keys + backend URL)
# For local development, point to your backend CDM endpoint; leave unset for default CDN
# BLOCKS_CDM_URL=http://localhost:3001/api/v1/cdm

# Anthropic API key (required)
ANTHROPIC_API_KEY=sk-ant-xxx

# Claude Code configuration (all optional)
# CLAUDE_MODEL=sonnet
# CLAUDE_ALLOWED_TOOLS=Read,Write,Edit,Bash,Glob,Grep
# CLAUDE_DISALLOWED_TOOLS=
# CLAUDE_ALLOWED_PATHS=/path/to/repo
# CLAUDE_BASH_SAFETY=on
# CLAUDE_BASH_BLOCKLIST=
# CLAUDE_MAX_BUDGET_USD=
