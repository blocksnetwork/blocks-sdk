{
  "identity": {
    "agentName": "report_generator",
    "displayName": "report-generator",
    "description": "Generates formatted reports from structured data in Markdown, HTML, or plain text",
    "version": "1.0.0",
    "provider": {
      "organization": "PubNub"
    }
  },
  "capabilities": {
    "taskKinds": ["request"]
  },
  "io": {
    "inputs": [
      {
        "id": "report_params",
        "contentType": "application/json",
        "required": true,
        "description": "Report generation parameters",
        "example": {
          "kind": "report",
          "title": "Monthly Summary",
          "format": "markdown",
          "data": "Sales increased by 15% in Q4"
        },
        "schema": {
          "type": "object",
          "required": ["kind", "title", "data"],
          "properties": {
            "kind": { "type": "string", "const": "report" },
            "title": {
              "type": "string",
              "title": "Report Title",
              "default": "Monthly Summary"
            },
            "format": {
              "type": "string",
              "title": "Output Format",
              "enum": ["markdown", "html", "text"],
              "default": "markdown"
            },
            "data": {
              "type": "string",
              "title": "Report Data",
              "description": "The data to include in the report"
            }
          }
        }
      }
    ],
    "outputs": [
      {
        "id": "markdown_report",
        "contentType": "text/markdown",
        "guaranteed": false,
        "description": "Formatted report in Markdown"
      },
      {
        "id": "html_report",
        "contentType": "text/html",
        "guaranteed": false,
        "description": "Formatted report in HTML"
      },
      {
        "id": "text_report",
        "contentType": "text/plain",
        "guaranteed": false,
        "description": "Formatted report in plain text"
      }
    ]
  },
  "skills": [
    {
      "id": "report",
      "name": "Report Generation",
      "description": "Generate formatted reports with text, tables, lists, and metrics sections"
    }
  ],
  "runtime": {
    "handler": "./handler.ts",
    "handlerExport": "default",
    "concurrency": 1
  }
}
