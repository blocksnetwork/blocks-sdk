# CDM config URL (provides PubNub keys + backend URL)
# For local development, point to your backend CDM endpoint; leave unset for default CDN
# BLOCKS_CDM_URL=http://localhost:3001/api/v1/cdm

# Required: Anthropic API key for Claude Agent SDK
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Tool configuration (optional)
# ---------------------------------------------------------------------------

# Comma-separated list of allowed Claude Code tools.
# Overrides the default set (Read, Write, Edit, Bash, Glob, Grep).
# CLAUDE_ALLOWED_TOOLS=Read,Write,Edit,Bash,Glob,Grep

# Comma-separated list of tools to remove from the allowlist.
# Applied after CLAUDE_ALLOWED_TOOLS or the default set.
# CLAUDE_DISALLOWED_TOOLS=Bash

# ---------------------------------------------------------------------------
# Filesystem sandboxing (optional)
# ---------------------------------------------------------------------------

# Comma-separated list of allowed working directory paths.
# If set, the handler rejects any cwd request outside these paths.
# CLAUDE_ALLOWED_PATHS=/home/user/projects,/tmp/scratch

# ---------------------------------------------------------------------------
# Bash safety (optional)
# ---------------------------------------------------------------------------

# Toggle bash command safety hooks: "on" (default) or "off".
# When on, dangerous commands (rm -rf /, sudo, etc.) are blocked.
# CLAUDE_BASH_SAFETY=on

# Comma-separated additional regex patterns to block in Bash commands.
# These are added to the built-in blocklist.
# CLAUDE_BASH_BLOCKLIST=pattern1,pattern2
