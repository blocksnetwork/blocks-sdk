{
  "identity": {
    "agentName": "bidi_chat_python",
    "displayName": "bidi-chat (Python)",
    "description": "Bidirectional echo over a single stream. The consumer writes lines and reads uppercased echoes from the agent until the consumer ends the stream.",
    "version": "1.0.0",
    "provider": {
      "organization": "PubNub"
    }
  },
  "capabilities": {
    "taskKinds": ["request", "pipe"]
  },
  "io": {
    "inputs": [
      {
        "id": "greeting",
        "description": "Optional greeting line streamed back before consumer messages.",
        "contentType": "application/json",
        "required": false,
        "example": { "text": "hello" },
        "schema": {
          "type": "object",
          "properties": {
            "text": { "type": "string" }
          }
        }
      }
    ],
    "outputs": [
      {
        "id": "transcript",
        "description": "Final transcript of all bidirectional messages.",
        "contentType": "text/plain",
        "guaranteed": true
      }
    ]
  },
  "streams": {
    "_default": {
      "direction": "bidirectional",
      "format": "events",
      "description": "Bidirectional event stream. Consumer sends { text } messages; agent replies with { text: <UPPERCASED> }.",
      "outboundSchema": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "description": "Agent reply (uppercased)." }
        }
      },
      "inboundSchema": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "description": "Consumer message." }
        }
      }
    }
  },
  "skills": [
    {
      "id": "main",
      "name": "Bidi Chat",
      "description": "Two-way streaming exercise of the consumer-side UUID derivation fix."
    }
  ],
  "runtime": {
    "handler": "./handler.py",
    "handlerExport": "handler",
    "concurrency": 1,
    "expectedInstances": 1,
    "maxPendingBacklog": 10,
    "maxRunningTimeSec": 60
  }
}
