{
  "identity": {
    "agentName": "echo_stream",
    "displayName": "echo-stream",
    "description": "Streams the input back chunk-by-chunk (word or line at a time), then returns the full text artifact.",
    "version": "1.0.0",
    "provider": {
      "organization": "PubNub"
    }
  },
  "capabilities": {
    "taskKinds": [
      "request",
      "pipe"
    ]
  },
  "io": {
    "inputs": [
      {
        "id": "text",
        "description": "Text to echo back as a stream",
        "contentType": "application/json",
        "required": true,
        "example": {
          "text": "Hello from the Blocks Network!"
        },
        "schema": {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string",
              "title": "Text to Echo",
              "default": "Hello from the Blocks Network!"
            }
          }
        }
      }
    ],
    "outputs": [
      {
        "id": "echoed",
        "description": "Streamed echoed text",
        "contentType": "text/plain",
        "guaranteed": true
      }
    ]
  },
  "streams": {
    "_default": {
      "direction": "outbound",
      "format": "events",
      "description": "Echoed text chunks streamed word-by-word or line-by-line."
    }
  },
  "tags": [
    {
      "id": "main",
      "name": "Echo Stream",
      "description": "Echoes input over stream and returns the full artifact"
    }
  ],
  "runtime": {
    "handler": "./handler.py",
    "handlerExport": "handler",
    "concurrency": 1,
    "expectedInstances": 1,
    "maxPendingBacklog": 10,
    "maxRunningTimeSec": 30
  }
}
