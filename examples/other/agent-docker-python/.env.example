# Copy this file to `.env` and fill in the values.
#
#   cp .env.example .env
#   # edit .env, set BLOCKS_BACKEND_URL, then run `blocks login --write-env`
#   # to populate BLOCKS_API_KEY.
#
# Optional: override the port the container talks to.
#   BACKEND_PORT=3001
#
# Optional: point at a different agent project (default: examples/python/echo).
#   AGENT_DIR=../../../blocks-sdk/examples/python/echo-stream
#
# Optional: align container clock with the host (defaults to UTC). On
# macOS the /etc/localtime mount is unreliable, so TZ is authoritative.
#   TZ=Europe/Warsaw

# Where `blocks login` / `blocks publish` talk to. Must match your local
# afui_mvp_backend port. Default in this worktree is 3011.
BLOCKS_BACKEND_URL=http://localhost:3011

# OAuth client_id the CLI presents at /api/auth/oauth2/authorize. Many
# distributed CLI builds ship with a production client_id baked in; set
# this explicitly to the value from your local oauth_client table so the
# local backend accepts the auth request. Find it via:
#   psql -c "SELECT client_id FROM oauth_client WHERE name='Blocks CLI';"
BLOCKS_CLI_CLIENT_ID=

# Populated by `blocks login --write-env`. Leave blank first; run login;
# the CLI writes it back here.
BLOCKS_API_KEY=
